{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upskill-to-ai/schemas/topic.schema.json",
  "title": "Topic",
  "description": "A group of related steps within a phase.",
  "$defs": {
    "Objective": {
      "additionalProperties": false,
      "properties": {
        "uuid": {
          "format": "uuid",
          "title": "Uuid",
          "type": "string"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "uuid",
        "order",
        "text"
      ],
      "title": "Objective",
      "type": "object"
    },
    "Resource": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "url": {
          "pattern": "^https://",
          "title": "Url",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "url"
      ],
      "title": "Resource",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "uuid": {
          "format": "uuid",
          "title": "Uuid",
          "type": "string"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "action": {
          "enum": [
            "watch",
            "read",
            "practice",
            "explore"
          ],
          "title": "Action",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "duration_minutes": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Minutes"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "resources": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Resource"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resources"
        },
        "variant_dimension": {
          "anyOf": [
            {
              "enum": [
                "provider",
                "coding_tool"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Dimension"
        },
        "variants": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Variant"
              },
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variants"
        }
      },
      "required": [
        "uuid",
        "order",
        "action",
        "title",
        "description"
      ],
      "title": "Step",
      "type": "object"
    },
    "Variant": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/Resource"
          },
          "minItems": 1,
          "title": "Resources",
          "type": "array"
        }
      },
      "required": [
        "key",
        "label",
        "resources"
      ],
      "title": "Variant",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "uuid": {
      "format": "uuid",
      "title": "Uuid",
      "type": "string"
    },
    "slug": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Slug",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "estimated_minutes": {
      "minimum": 1,
      "title": "Estimated Minutes",
      "type": "integer"
    },
    "is_capstone": {
      "default": false,
      "title": "Is Capstone",
      "type": "boolean"
    },
    "objectives": {
      "items": {
        "$ref": "#/$defs/Objective"
      },
      "minItems": 1,
      "title": "Objectives",
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "uuid",
    "slug",
    "name",
    "description",
    "estimated_minutes",
    "objectives",
    "steps"
  ],
  "type": "object"
}
