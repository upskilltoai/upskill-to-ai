{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upskill-to-ai/schemas/phase.schema.json",
  "title": "Phase",
  "description": "The *authored* shape \u2014 `content/phases/phaseN/_phase.yaml`, exactly\nwhat a human writes. `topics` is a plain list of slugs; the compiler\nreplaces this with full `Topic` objects when building the artifact\n(see `CompiledPhase`), and adds `estimated_minutes` (summed from\nthose topics) \u2014 neither of which a phase file ever contains itself.",
  "$defs": {
    "HandsOnVerification": {
      "additionalProperties": false,
      "properties": {
        "requirements": {
          "anyOf": [
            {
              "items": {
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requirements"
        }
      },
      "title": "HandsOnVerification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "uuid": {
      "format": "uuid",
      "title": "Uuid",
      "type": "string"
    },
    "slug": {
      "pattern": "^phase[0-9]+$",
      "title": "Slug",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "short_description": {
      "minLength": 1,
      "title": "Short Description",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "order": {
      "minimum": 1,
      "title": "Order",
      "type": "integer"
    },
    "hands_on_verification": {
      "anyOf": [
        {
          "$ref": "#/$defs/HandsOnVerification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "topics": {
      "items": {
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Topics",
      "type": "array"
    }
  },
  "required": [
    "uuid",
    "slug",
    "name",
    "short_description",
    "description",
    "order",
    "topics"
  ],
  "type": "object"
}
